# Model backend: "ollama" (lightweight Python environment) or "huggingface".
ASKBIO_BACKEND=ollama

# Ollama runs outside the Python environment and keeps PyTorch out of .venv.
OLLAMA_BASE_URL=http://localhost:11434
ASKBIO_LLM_MODEL=phi3:mini
ASKBIO_EMBEDDING_MODEL=nomic-embed-text

# Paths default to these locations when omitted.
ASKBIO_DATA_DIR=./data/sample
ASKBIO_INDEX_DIR=./.askbio_index

# Retrieval settings.
ASKBIO_TOP_K=4
ASKBIO_SIMILARITY_CUTOFF=0.55
ASKBIO_CHUNK_SIZE=512
ASKBIO_CHUNK_OVERLAP=64
