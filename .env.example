# llama.cpp runs outside the Python environment and keeps PyTorch out of .venv.
# Start separate llama servers for chat and a dedicated embedding model.
ASKBIO_LLM_BASE_URL=http://127.0.0.1:8080/v1
ASKBIO_EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
ASKBIO_LLM_MODEL=askbio-chat
ASKBIO_EMBEDDING_MODEL=askbio-embed
ASKBIO_API_KEY=llama.cpp

# Paths default to these locations when omitted.
ASKBIO_DATA_DIR=./data/sample
ASKBIO_INDEX_DIR=./.askbio_index

# Retrieval settings.
ASKBIO_TOP_K=4
ASKBIO_SIMILARITY_CUTOFF=0.55
ASKBIO_CHUNK_SIZE=512
ASKBIO_CHUNK_OVERLAP=64
